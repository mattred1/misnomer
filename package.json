{
    "name": "misnomer",
    "productName": "Misnomer",
    "version": "1.0.0",
    "description": "Renames PDFs and images based on their content",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder --mac",
        "test": "node --test",
        "lint": "eslint .",
        "pricing:update": "node scripts/update-pricing.js",
        "format": "prettier --write ."
    },
    "build": {
        "appId": "com.example.misnomer",
        "productName": "Misnomer",
        "files": [
            "main.js",
            "preload.js",
            "renderer/**/*",
            "pricing/**/*",
            "node_modules/**/*"
        ],
        "mac": {
            "category": "public.app-category.productivity",
            "target": [
                "dmg"
            ]
        }
    },
    "dependencies": {
        "jszip": "^3.10.2",
        "pdfjs-dist": "^3.11.174"
    },
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "electron": "^44.8.0",
        "electron-builder": "^26.15.3",
        "eslint": "^9.15.0",
        "globals": "^15.12.0",
        "prettier": "^3.3.3"
    }
}
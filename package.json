{
    "name": "misnomer",
    "productName": "Misnomer",
    "version": "1.0.0",
    "description": "Renames PDFs and images based on their content",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder --mac --publish never",
        "dist:all": "electron-builder --mac --x64 --arm64 --publish never",
        "dist:signed": "electron-builder --mac --publish never -c.mac.notarize=true",
        "dist:signed:all": "electron-builder --mac --x64 --arm64 --publish never -c.mac.notarize=true",
        "test": "node --test",
        "lint": "eslint .",
        "icons": "electron scripts/build-icons.js",
        "pricing:update": "node scripts/update-pricing.js",
        "format": "prettier --write ."
    },
    "build": {
        "appId": "io.github.mattred1.misnomer",
        "productName": "Misnomer",
        "files": [
            "main.js",
            "preload.js",
            "renderer/**/*",
            "pricing/**/*",
            "node_modules/**/*"
        ],
        "mac": {
            "icon": "build/icon.icns",
            "category": "public.app-category.productivity",
            "target": [
                "dmg",
                "zip"
            ],
            "hardenedRuntime": true,
            "gatekeeperAssess": false
        },
        "publish": {
            "provider": "github",
            "owner": "mattred1",
            "repo": "misnomer"
        }
    },
    "dependencies": {
        "archiver": "^7.0.1",
        "electron-updater": "^6.8.9",
        "jszip": "^3.10.2",
        "pdfjs-dist": "^3.11.174"
    },
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "electron": "^44.8.0",
        "electron-builder": "^26.15.3",
        "eslint": "^9.15.0",
        "globals": "^15.12.0",
        "prettier": "^3.3.3"
    }
}
